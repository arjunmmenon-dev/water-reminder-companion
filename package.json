{
  "name": "desktop-companion",
  "version": "0.1.0",
  "private": true,
  "description": "Transparent desktop companion (Electron + Vue 3)",
  "author": "Desktop Companion",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "icons:generate": "node scripts/generate-app-icon.mjs",
    "dist:win": "npm run icons:generate && npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12",
    "sharp": "^0.34.1",
    "to-ico": "^1.1.5",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vue-tsc": "^2.2.0"
  },
  "build": {
    "appId": "com.desktopcompanion.app",
    "productName": "Desktop Companion",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist-electron/assets/icons/app-icon.png",
        "to": "assets/icons/app-icon.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/app-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icons/app-icon.ico",
      "uninstallerIcon": "assets/icons/app-icon.ico"
    },
    "artifactName": "${productName} Setup ${version}.${ext}"
  }
}
